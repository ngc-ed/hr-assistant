# Copia este archivo como .env y llena solo lo que necesites.
# Nunca subas el .env al repositorio: los tokens y claves son secretos.

# Modelo: fake (simulado, sin red) o gateway (Workers AI por AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Observabilidad (sesión 2)
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare (sesión 3): obligatorias con MODEL_PROVIDER=gateway
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Modelos y palancas de costo (sesión 3)
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Seguridad y límites (sesión 4)
ENVIRONMENT=development
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
